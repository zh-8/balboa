# Context for infra/bootstrap/bootstrap.sh.
#
# Copy to infra/bootstrap/.env (gitignored) and fill in, or export these in your shell.
# bootstrap.sh asserts the first two against the subscription you are actually logged
# into and refuses to run on a mismatch — that assert is what keeps it off unrelated
# subscriptions, so set them to the subscription you intend to change, not to whatever
# `az account show` happens to print.
#
# These are kept out of the repository because it is public. They are not credentials,
# but a tenant id identifies an Entra directory well enough to enumerate its login and
# federation configuration, and anything pushed to a public repo is effectively
# permanent. See CLAUDE.md section 4.
#
#   az account show --query id     --output tsv   # BALBOA_SUBSCRIPTION_ID
#   az account show --query tenantId --output tsv # BALBOA_TENANT_ID

BALBOA_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
BALBOA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Recipient for the budget alerts at 50/80/100% of the monthly cap, and the forecast alert.
BALBOA_ALERT_EMAIL=you@example.com
