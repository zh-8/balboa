<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft.Testing.Extensions.CodeCoverage settings (ADR-0014): instrument only the
     Domain and Application assemblies. Infrastructure, Host, Contracts, TestKit, migrations
     and generated code are left out. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*\.Domain\.dll$</ModulePath>
        <ModulePath>.*\.Application\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <Sources>
      <Exclude>
        <Source>.*[\\/]Migrations[\\/].*</Source>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
