<Project Sdk="Microsoft.NET.Sdk">

  <!-- Boundary and layering rules (CLAUDE.md section 5, layer 2). No Docker. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referencing the Host pulls every module assembly (all layers) into this project's output. -->
    <ProjectReference Include="..\..\src\Balboa.Host\Balboa.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
