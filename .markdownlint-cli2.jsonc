{
  // Markdown lint rules. Deliberately permissive where the default rule fights
  // technical writing, strict where inconsistency actually hurts readability.
  "config": {
    "default": true,

    // Line length: prose wraps at 100, but tables, code blocks and long URLs
    // cannot be wrapped without making them worse.
    "MD013": {
      "line_length": 100,
      "tables": false,
      "code_blocks": false,
      "headings": false
    },

    // Duplicate headings are fine when nested under different parents —
    // every ADR has "Context", every runbook has "Verify".
    "MD024": { "siblings_only": true },

    // A document may legitimately open with front matter or a note before the
    // H1, and ADR/spec templates do.
    "MD041": false,

    // Specs carry a `title:` key in their YAML front matter, which markdownlint
    // otherwise counts as a first H1 — making the document's real H1 look like a
    // duplicate. Setting front_matter_title empty stops it inferring one.
    "MD025": { "front_matter_title": "" },

    // Inline HTML is needed for the diagram figures and template comments.
    "MD033": false,

    // Bare URLs are flagged; we always use proper links, so keep this on.
    "MD034": true,

    // Emphasis used as a heading — the templates use bold labels like
    // **Why:** inside list items, which is intentional.
    "MD036": false,

    // Table pipe padding, added in markdownlint v0.42 (markdownlint-cli2 0.24).
    // It wants `| --- | --- |` and flags the compact `|---|---|` separator used
    // throughout this repo — 110 findings, every one cosmetic and none of them a
    // rendering difference, since both are valid GFM. Reformatting every table to
    // satisfy pipe spacing buys nothing, so the rule is off rather than bulk-fixed.
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/bin/**",
    "**/obj/**",
    ".github/ISSUE_TEMPLATE/**",

    // Agent definitions are prompts, not prose for humans; wrapping them to 100
    // columns would hurt them.
    ".claude/**",

    // Generated by the Angular CLI. Not worth reformatting, and it is replaced
    // wholesale whenever the workspace is regenerated.
    "frontend/README.md"
  ]
}
