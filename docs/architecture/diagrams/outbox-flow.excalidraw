      "updated": 1760832000000,
      "link": null,
      "locked": false,
      "text": "Startup sweep: every host start re-publishes outbox rows that were committed but never delivered\n(crash between commit and dispatch). Scale-to-zero means a background poller cannot be relied on.\nDelivery is at-least-once; the inbox makes the effect exactly-once.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sweep",
      "originalText": "Startup sweep: every host start re-publishes outbox rows that were committed but never delivered\n(crash between commit and dispatch). Scale-to-zero means a background poller cannot be relied on.\nDelivery is at-least-once; the inbox makes the effect exactly-once.",
      "autoResize": true,
      "lineHeight": 1.25
    },
